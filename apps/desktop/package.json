{
  "name": "@herdr-bot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "setup": "vite build && electron . --setup",
    "start:cdp": "vite build && electron . --user-data-dir=\"${TMPDIR:-/tmp}/herdr-bot-cdp-${CDP_PORT:-9333}\" --remote-debugging-port=${CDP_PORT:-9333}",
    "typecheck": "tsc -p app"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@herdr-bot/protocol": "workspace:*",
    "@herdr-bot/setup": "workspace:*",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
